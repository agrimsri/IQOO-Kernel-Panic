{
  "about": "TraceVeil website-check data (MIT, TraceVeil's own). pathRules: tracking endpoints that share a host with ordinary pages, so the host alone cannot decide (the URL path does). cookies: first-party cookie names a vendor documents for its own tracking script. Every rule cites the vendor page it was read from on 11 October 2026; the quote is a short excerpt of that page. Entities are tracker-catalogue entity names where the catalogue has one.",
  "pathRules": [
    {
      "entity": "Meta (Facebook SDK)",
      "hosts": ["facebook.com"],
      "pathPrefix": "/tr",
      "source": "https://developers.facebook.com/docs/meta-pixel/get-started",
      "quote": "src=\"https://www.facebook.com/tr?id={your-pixel-id-goes-here}&ev=PageView&noscript=1\""
    },
    {
      "entity": "Pinterest Tag",
      "category": "ADVERTISING",
      "company": "Pinterest",
      "hosts": ["s.pinimg.com"],
      "pathPrefix": "/ct/",
      "source": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/",
      "quote": "\"https://s.pinimg.com/ct/core.js\""
    }
  ],
  "cookies": [
    {
      "entity": "Google Analytics",
      "patterns": ["_ga", "_ga_*"],
      "source": "https://support.google.com/analytics/answer/11397207",
      "quote": "_ga | 2 years | Used to distinguish users."
    },
    {
      "entity": "Google Analytics",
      "patterns": ["_gid", "_gat", "_gat_*"],
      "source": "https://business.safety.google/adscookies/",
      "quote": "_gid | Analytics ... _gat[_<customname>] | Analytics"
    },
    {
      "entity": "Google Ads / AdMob",
      "patterns": ["_gcl_au", "_gcl_aw"],
      "source": "https://business.safety.google/adscookies/",
      "quote": "_gcl_au | Analytics, Advertising, Security"
    },
    {
      "entity": "Meta (Facebook SDK)",
      "patterns": ["_fbp", "_fbc"],
      "source": "https://developers.facebook.com/docs/marketing-api/conversions-api/parameters/fbp-and-fbc",
      "quote": "automatically saves a unique identifier to an _fbp cookie for the website domain"
    },
    {
      "entity": "Microsoft Clarity",
      "patterns": ["_clck", "_clsk"],
      "source": "https://learn.microsoft.com/en-us/clarity/setup-and-installation/clarity-cookies",
      "quote": "_clck | Persists the Clarity User ID and preferences"
    },
    {
      "entity": "Hotjar",
      "patterns": ["_hjSessionUser_*", "_hjSession_*"],
      "source": "https://help.hotjar.com/hc/en-us/articles/36819973371409-Cookies-Set-by-the-Hotjar-Tracking-Code",
      "quote": "Persists the Hotjar User ID which is unique to that site."
    },
    {
      "entity": "TikTok Pixel",
      "category": "ADVERTISING",
      "company": "TikTok",
      "patterns": ["_ttp"],
      "source": "https://ads.tiktok.com/help/article/using-cookies-with-tiktok-pixel?lang=en",
      "quote": "_ttp ... These cookies are created and owned by your website and are used to recognize a person on your domain only."
    },
    {
      "entity": "Amplitude",
      "patterns": ["AMP_*"],
      "source": "https://amplitude.com/docs/sdks/analytics/browser/browser-sdk-2",
      "quote": "The SDK creates user session cookies with AMP prefix and the first ten digits of the API key"
    },
    {
      "entity": "Mixpanel",
      "patterns": ["mp_*_mixpanel"],
      "source": "https://raw.githubusercontent.com/mixpanel/mixpanel-js/master/src/mixpanel-persistence.js",
      "quote": "this.name = 'mp_' + config['token'] + '_mixpanel';"
    },
    {
      "entity": "Segment",
      "patterns": ["ajs_anonymous_id", "ajs_user_id"],
      "source": "https://www.twilio.com/docs/segment/connections/sources/catalog/libraries/website/javascript/cookie-validity-update",
      "quote": "anonymousId | ajs_anonymous_id"
    }
  ]
}
